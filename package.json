    "test:details": "node --test scripts/test-data-bpe.mjs scripts/test-layout-vocab.mjs scripts/test-pipeline.mjs scripts/test-serving-scheduler.mjs scripts/test-engineering-check.mjs",
    "test:chains": "node --test scripts/test-computation-chains.mjs",
