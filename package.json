    "test:objectives": "node --test scripts/test-objective-chains.mjs",
    "test:memory": "node --test scripts/test-memory-chains.mjs",
    "lab:memory": "node scripts/run-memory-lab.mjs",
    "test:decisions": "node --test scripts/test-decision-chains.mjs",
    "lab:decisions": "node scripts/run-decision-lab.mjs",
    "lab:ann": "node scripts/run-ann-lab.mjs",
    "test:decision-ui": "node scripts/test-decision-interactions.mjs",
    "lab:learning": "node scripts/run-learning-lab.mjs",
    "lab:failures": "node scripts/run-failure-lab.mjs",
    "lab:dynamics": "node scripts/run-dynamics-lab.mjs",
    "lab:output": "node scripts/run-output-lab.mjs",
    "test:learning-ui": "node scripts/test-learning-dynamics-ui.mjs",
    "test:layout": "node scripts/check-layout.mjs",
    "test:interactions": "node scripts/test-interactions.mjs",
    "test:audit": "node scripts/audit-site.mjs",
    "test:learning": "node --test scripts/test-learning-run.mjs scripts/test-failure-replay.mjs scripts/test-training-dynamics.mjs scripts/test-chunked-ce.mjs && .venv-framework/bin/python scripts/test-learning-core.py && .venv-framework/bin/python scripts/test-failure-replay.py && .venv-framework/bin/python scripts/test-training-dynamics.py && .venv-framework/bin/python scripts/test-chunked-ce.py && .venv-framework/bin/python scripts/test-learning-artifacts.py",
    "lab:retrieval-filtering": "node scripts/run-retrieval-filtering.mjs",
